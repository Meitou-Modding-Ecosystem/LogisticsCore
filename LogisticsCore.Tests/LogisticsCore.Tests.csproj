<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logistics Core's tests (docs/logistics-core.md, docs/balance-runner.md): networks made in memory, no game install needed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Logistics.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Simulation/Meitou.Simulation.csproj" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Game/Meitou.Game.csproj" />
    <ProjectReference Include="../LogisticsCore/LogisticsCore.csproj" />
    <ProjectReference Include="../LogisticsRunner/LogisticsRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LogisticsCore/meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
